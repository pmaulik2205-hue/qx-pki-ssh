# R4-31 SSH server crypto settings: PQC hybrid KEX first, classical fallbacks still allowed.
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256,diffie-hellman-group14-sha1
HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,ssh-rsa
PubkeyAcceptedAlgorithms ssh-ed25519,rsa-sha2-256,ssh-rsa
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-cbc
